#include <stdio.h>

#define MAX 50

/* Structure for Page Replacement */
typedef struct
{
    int pages[MAX]; /* Reference string */
    int frames[MAX]; /* Memory frames */
    int recent[MAX]; /* Used for LRU */
    int n; /* Number of pages */
    int f; /* Number of frames */
    int faults; /* Page faults */
    int hits; /* Page hits */
} Page;


/* Search page in frames */
int search(Page *p, int page)
{
    int i;

    for (i = 0; i < p->f; i++)
    {
        if (p->frames[i] == page)
            return 1;
    }

    return 0;
}


/* Display frames */
void display(Page *p, int page)
{
    int i;

    printf("Page %d : ", page);

    for (i = 0; i < p->f; i++)
    {
        if (p->frames[i] == -1)
            printf("- ");
        else
            printf("%d ", p->frames[i]);
    }

    printf("\n");
}


/* FIFO Page Replacement */
void FIFO(Page *p)
{
    int i, j;
    int pointer = 0;

    p->faults = 0;
    p->hits = 0;

    /* Initialize frames */
    for (i = 0; i < p->f; i++)
        p->frames[i] = -1;

    for (i = 0; i < p->n; i++)
    {
        if (search(p, p->pages[i]))
        {
            p->hits++;
        }
        else
        {
            p->frames[pointer] = p->pages[i];

            pointer = (pointer + 1) % p->f;

            p->faults++;
        }

        display(p, p->pages[i]);
    }

    printf("\nFIFO Page Faults = %d", p->faults);
    printf("\nFIFO Page Hits = %d\n", p->hits);
}


/* LRU Page Replacement */
void LRU(Page *p)
{
    int i, j;
    int pos, least;

    p->faults = 0;
    p->hits = 0;

    /* Initialize frames */
    for (i = 0; i < p->f; i++)
    {
        p->frames[i] = -1;
        p->recent[i] = -1;
    }

    for (i = 0; i < p->n; i++)
    {
        if (search(p, p->pages[i]))
        {
            /* Page hit */
            p->hits++;

            for (j = 0; j < p->f; j++)
            {
                if (p->frames[j] == p->pages[i])
                    p->recent[j] = i;
            }
        }
        else
        {
            /* Page fault */
            p->faults++;

            pos = -1;

            /* Find empty frame */
            for (j = 0; j < p->f; j++)
            {
                if (p->frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            /* Find least recently used frame */
            if (pos == -1)
            {
                least = p->recent[0];
                pos = 0;

                for (j = 1; j < p->f; j++)
                {
                    if (p->recent[j] < least)
                    {
                        least = p->recent[j];
                        pos = j;
                    }
                }
            }

            p->frames[pos] = p->pages[i];
            p->recent[pos] = i;
        }

        display(p, p->pages[i]);
    }

    printf("\nLRU Page Faults = %d", p->faults);
    printf("\nLRU Page Hits = %d\n", p->hits);
}


/* Optimal Page Replacement */
void Optimal(Page *p)
{
    int i, j, k;
    int pos, farthest, next;

    p->faults = 0;
    p->hits = 0;

    /* Initialize frames */
    for (i = 0; i < p->f; i++)
        p->frames[i] = -1;

    for (i = 0; i < p->n; i++)
    {
        if (search(p, p->pages[i]))
        {
            /* Page hit */
            p->hits++;
        }
        else
        {
            /* Page fault */
            p->faults++;

            pos = -1;

            /* Find empty frame */
            for (j = 0; j < p->f; j++)
            {
                if (p->frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            /* If no empty frame, find optimal page */
            if (pos == -1)
            {
                farthest = -1;
                pos = 0;

                for (j = 0; j < p->f; j++)
                {
                    next = -1;

                    /* Find next use of current frame page */
                    for (k = i + 1; k < p->n; k++)
                    {
                        if (p->frames[j] == p->pages[k])
                        {
                            next = k;
                            break;
                        }
                    }

                    /* Page is not used again */
                    if (next == -1)
                    {
                        pos = j;
                        break;
                    }

                    /* Page used farthest in future */
                    if (next > farthest)
                    {
                        farthest = next;
                        pos = j;
                    }
                }
            }

            p->frames[pos] = p->pages[i];
        }

        display(p, p->pages[i]);
    }

    printf("\nOptimal Page Faults = %d", p->faults);
    printf("\nOptimal Page Hits = %d\n", p->hits);
}


/* Main Function */
int main()
{
    Page p;
    int choice;
    int i;

    printf("===== PAGE REPLACEMENT =====\n");

    printf("\nEnter number of pages in reference string: ");
    scanf("%d", &p.n);

    printf("Enter reference string:\n");

    for (i = 0; i < p.n; i++)
        scanf("%d", &p.pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &p.f);

    do
    {
        printf("\n\n===== MENU =====");
        printf("\n1. FIFO");
        printf("\n2. LRU");
        printf("\n3. Optimal");
        printf("\n4. All Algorithms");
        printf("\n5. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("\n--- FIFO ---\n");
                FIFO(&p);
                break;

            case 2:
                printf("\n--- LRU ---\n");
                LRU(&p);
                break;

            case 3:
                printf("\n--- Optimal ---\n");
                Optimal(&p);
                break;

            case 4:
                printf("\n--- FIFO ---\n");
                FIFO(&p);

                printf("\n--- LRU ---\n");
                LRU(&p);

                printf("\n--- Optimal ---\n");
                Optimal(&p);
                break;

            case 5:
                printf("\nProgram terminated.\n");
                break;

            default:
                printf("\nInvalid choice!");
        }

    } while (choice != 5);

    return 0;
}
